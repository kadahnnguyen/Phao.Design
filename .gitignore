# Build output. Regenerated by `node build.mjs`, never edited by hand.
dist/

# Intermediate extractions from the client's PDFs. Regenerate with
# `python tools/extract-images.py`. Deliberately not committed: the
# _flattened-do-not-publish/ folder holds whole pages rasterised with their layout
# text, including the client's student ID and personal contact block, and none of
# that should ever reach a public repo. Only the curated, resized files under
# static/img/ are part of the site.
tools/extracted/

# Everything the client sent: the request form, their uploads, their moodboards.
# Source material, not site source. Verified with `git check-ignore`: a leading "./"
# does not work here, git reads it as a literal path segment and ignores nothing.
client-resources/

# Wrangler's local state. `wrangler-account.json` caches the Cloudflare account id and
# name of whoever last deployed, which during the build is Khoa. Section 7 says nothing
# in this repo hard-codes his account, and this repo transfers to Đan, so it stays out.
.wrangler/
node_modules/

# Local noise
.DS_Store
Thumbs.db
*.log
tools/

# Personal reference
CLIENT-BUILD-CONTEXT.md
.claude/